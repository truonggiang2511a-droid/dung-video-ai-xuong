nd":12.79,"text":"Kế bên làng đại học Hưng Long của Vingroup xuất hiện căn nhà phố thiết kế chắc chắn, kiên cố, bảo hành nhà dài hạn, thanh toán trước 1 tỷ 900 triệu, dọn vào, ở liền.","n":36},{"i":1,"start":13.97,"end":29.17,"text":"Với kết cấu 1 trệt 2 tầng lầu, tổng diện tích 138m2, ngang 4m30 so vào 31m, công đăng sân trước, sân sau, ban công sân thượng, cùng với đó là 4 phòng ngủ, 1 phòng sinh hòa chung và 4 toilet thiết kế full","n":45},{"i":2,"start":29.17,"end":30.15,"text":"toàn bộ nội thất.","n":4},{"i":3,"start":30.15,"end":43.33,"text":"Và với hướng chính của các nhà là mặt tiền đường nhựa thông, khu dân cư đông đúc, lưu lượng xe ra vào tấp nập, mặt tiền kinh doanh đa ngành nghề, căn nhà thiết kế theo phong cách hiện đại, thông thoáng nhiều cây","n":45},{"i":4,"start":43.33,"end":44.57,"text":"xanh hướng Đông Nam.","n":4},{"i":5,"start":47.88,"end":52.66,"text":"Sân trước có chiều sâu là 8m, có xích đu, có trồng rất nhiều mảng xanh.","n":16},{"i":6,"start":52.66,"end":66.72,"text":"Một nơi Nơi thể hiện đẳng cấp của gia chủ, bước vào bên trong đây chúng ta sẽ có một không gian phòng khách được bố trí hài hòa giữa ánh sáng cùng với tông màu nội thất trầm ấm và ở đây thì cũng","n":45},{"i":7,"start":66.72,"end":76.24,"text":"đã được bố trí đầy đủ là bàn ghế sofa, bàn trà cỡ lớn, hệ kệ tủ TV, những vật dụng đề co, cùng với đó là trần cao thoáng.","n":30},{"i":8,"start":76.66,"end":79.76,"text":"Ngồi tại đây thì chúng ta có thể view ra sân vườn xanh mát.","n":14},{"i":9,"start":81.12,"end":84.92,"text":"Và đây chính là nơi dành cho những bữa ăn ngon của nhà mình đây ạ.","n":16},{"i":10,"start":85.3,"end":98.44,"text":"Bố trí sẵn cho chúng ta tủ bếp trên dưới, bàn ăn, bàn đảo, thiết bị điện là tủ lạnh side by side, hai cánh, bếp nấu, máy hút mùi, không gian đầy đủ tiện nghi dành cho đại gia đình của mình ạ.","n":44},{"i":11,"start":98.44,"end":99.68,"text":"Đấy, anh ơi.","n":3},{"i":12,"start":102.2,"end":109.98,"text":"Lavabo thì được đẩy hẳn ra bên ngoài để tiện gia đình mình sinh hoạt và chúng ta sẽ có một khu vực toilet sử dụng chung cho toàn bộ khu vực tầng.","n":33},{"i":13,"start":110,"end":111.06,"text":"Phòng ngủ dưới tầng trệt rộng rãi.","n":7},{"i":14,"start":113.52,"end":126.82,"text":"Phòng ngủ dưới tầng trệt phù hợp cho ông bà người thân lớn tuổi, đầy đủ trang thiết bị nội thất, sương ngủ, tủ quần áo, kệ tủ tivi, máy lạnh quạt chân thông thoáng và hãy tưởng tượng mỗi buổi sáng thức dậy đón","n":45},{"i":15,"start":126.82,"end":129.46,"text":"bình minh bằng một chiếc view tuyệt đẹp như thế này.","n":11},{"i":16,"start":131.27,"end":139.63,"text":"Như một khu rừng nhỏ, phía khu vực sân sau được bố trí hồ cá, cây xanh, ngồi đây uống trà, thử thức cà phê, chiêu chiêu.","n":27},{"i":17,"start":141.97,"end":150.27,"text":"Không gian sinh hoạt chung đã được bố trí đầy đủ hết nội thất, phù hợp cho gia đình của mình có thể làm phòng đọc sách hoặc phòng khách số 2.","n":32},{"i":18,"start":155.42,"end":163.72,"text":"Không gian phòng ngủ cho các con thì cũng đã được bố trí đầy đủ hết nội thất, bao gồm giường ngủ đôi, nệm, gối,","n":25},{"i":19,"start":164.38,"end":164.98,"text":"tủ quần áo.","n":3},{"i":20,"start":166.22,"end":168.9,"text":"Bên đây là hệ thống bàn học nôi cho bé,","n":10},{"i":21,"start":169.56,"end":174.02,"text":"đặc biệt hơn nữa là có view ra khu vực ban công rất là thoáng ở phía đằng sau.","n":19},{"i":22,"start":174.96,"end":183.2,"text":"Phòng ngủ mát tơ phù hợp cho cha mẹ đã được bố trí cũng đầy đủ hết nội thất là giường ngủ, tủ quần áo, kệ tủ ti ti,","n":29},{"i":23,"start":184.02,"end":187.82,"text":"ban công thoáng phía trước cũng như đó là toilet khép kín ở bên trong.","n":15},{"i":24,"start":190.52,"end":198.02,"text":"Căn nhà được đổ đúc thật hoàn toàn và có thiết kế khu vực diễn trời rất là lớn ở đây, hệ thống đèn buông thả lung linh.","n":28},{"i":25,"start":198.56,"end":204.14,"text":"Và trên khu vực lầu 2 sẽ có một phòng ngủ, một khu vực vệ sinh rộng rãi cũng với đó là sân thượng phía sau.","n":26},{"i":26,"start":204.76,"end":210.56,"text":"Ban công của căn phòng số 4, phòng này thì gia đình mình có thể làm phòng thờ hoặc phòng ngủ.","n":21},{"i":27,"start":211.96,"end":216.34,"text":"Khu vực sân thượng phù hợp cho gia đình của mình tổ chức tiệc BBQ ngoài trời.","n":17},{"i":28,"start":216.34,"end":219.64,"text":"Ở đây thì đã có sẵn một bàn tiệc bao gồm 10 ghế này.","n":14},{"i":29,"start":220,"end":226,"text":"Lò nướng, quầy ba mini, bếp từ nấu và đã được trồng cây xanh và cây an trái.","n":18}],"silences":[[0,0.75],[8.7,9.05],[12.9,14.35],[21.25,21.6],[28.2,28.55],[32.5,33],[37.7,38.1],[39.8,40.25],[41.95,42.4],[44.6,47.05],[47.3,48.2],[52.75,53.65],[53.75,54.65],[70.8,71.15],[79.75,80.7],[80.8,81.45],[92.95,93.35],[98.4,98.8],[99.85,102.1],[111.05,112.35],[112.5,113.9],[129.5,131.6],[140.35,141.1],[141.3,142.35],[150.35,150.95],[152.5,155.85],[162.4,162.8],[163.8,164.4],[166.15,166.65],[169.05,169.5],[174.4,175.3],[183.35,184],[187.85,190.85],[204.2,205.05],[210.7,212.35],[222.85,223.3],[226.05,226.60000000000002]],"fillCuts":[],"mumbleCuts":[[12.94,13.82],[17.979999999999997,18.92],[44.72,47.730000000000004],[53.309999999999995,54.730000000000004],[79.91000000000001,80.97],[99.83000000000001,102.05],[111.21000000000001,113.36999999999999],[129.61,131.12],[139.78,141.82],[150.42000000000002,155.27],[165.13,166.07],[174.17000000000002,174.81],[187.97,190.37],[210.71,211.81]],"dur":226.557098}