đăng","s":211.8,"e":211.96},{"w":"ký","s":211.96,"e":212.1},{"w":"kênh","s":212.1,"e":215},{"w":"để","s":215,"e":215.07999999999998},{"w":"chúng","s":215.07999999999998,"e":215.24},{"w":"ta","s":215.24,"e":215.36},{"w":"cùng","s":215.36,"e":215.5},{"w":"xem","s":215.5,"e":215.76},{"w":"nhiều","s":215.76,"e":216.14},{"w":"căn","s":216.14,"e":216.46},{"w":"nhà","s":216.46,"e":216.64},{"w":"đẹp","s":216.64,"e":216.9},{"w":"giá","s":216.9,"e":217.1},{"w":"tốt","s":217.1,"e":217.32},{"w":"trên","s":217.32,"e":217.56},{"w":"kênh","s":217.56,"e":217.76},{"w":"Nhà","s":217.76,"e":217.9},{"w":"Sinh","s":217.9,"e":218.06},{"w":"Minh","s":218.06,"e":218.18},{"w":"Thùy","s":218.18,"e":218.46},{"w":"ạ.","s":218.46,"e":218.6},{"w":"Xin","s":218.92000000000002,"e":219.06},{"w":"chào.","s":219.06,"e":219.4}],"sentences":[{"i":0,"start":0.53,"end":7.87,"text":"Khu đô thị 5 sao xuất hiện một căn nhà thiết kế 1 chệt 3 tầng lầu và giá phải nói là rẻ nhất trong khu luôn.","n":27},{"i":1,"start":8.35,"end":17.05,"text":"Và ở đây với diện tích là ngang 5,5m và sâu vào 15m, nằm trên trục đường số 3 có độ rộng là 8m, vỉa hẻ hệ thống điện âm cây xanh.","n":32},{"i":2,"start":17.21,"end":24.19,"text":"Và khu đô thị 5 sao thuộc về Phước Lý Cần Dũ Long An, giáp ranh với Bình Chánh của thành phố Hồ Chí Minh, chỉ có vài bước chân thôi.","n":31},{"i":3,"start":24.39,"end":29.73,"text":"Nằm ngay với tuyến cao tốc Bến Lức Long Thành – Dầu Dây, cách trợ Bình Chánh 2km di chuyển.","n":20},{"i":4,"start":29.73,"end":35.45,"text":"Và ở đây trục đường có rất nhiều cây xanh mát mẻ, khu dân cư thì cực kỳ là đông đúc cho mình rồi.","n":24},{"i":5,"start":35.77,"end":45.81,"text":"Diện tích lý tưởng ngang 5,5m, sâu 15m, thiết kế đầy đủ công năng có sân trước, có sân sau, mái che không rào đầy đủ và phía trên.","n":29},{"i":6,"start":46.19,"end":54.97,"text":"Và các nhà thì sẽ có công năng là phòng khách, phòng bếp rộng thoáng, 4 căn phòng ngủ, 5 toilet và gia chủ sẽ để...","n":26},{"i":7,"start":58.28,"end":61.38,"text":"Bước vào căn nhà thật sự rất thông thoáng.","n":9},{"i":8,"start":61.94,"end":68.22,"text":"Nhà đổ đúc thật hoàn toàn từ dưới lên trên và với không gian khách, bếp, mắt.","n":17},{"i":9,"start":71.58,"end":74.66,"text":"Vô, hai lớp cửa bảo vệ có đầy đủ công năng.","n":11},{"i":10,"start":75.36,"end":76.88,"text":"Các nhà có đầy đủ công năng.","n":7},{"i":11,"start":81.98,"end":82.5,"text":"Và","n":1},{"i":12,"start":87.3,"end":94.74,"text":"với đầy đủ công năng sân trước sân sau, bàn công sân thượng, hai lớp cửa bảo vệ, mái che không rào đầy đủ hết.","n":25},{"i":13,"start":95.18,"end":98.14,"text":"Bước vào nhà thì không gian cực kỳ là mát mẻ.","n":11},{"i":14,"start":98.62,"end":104.16,"text":"Và căn nhà sẽ có khách và bếp cùng với đó là bốn phòng ngủ, năm khu vực vệ sinh.","n":20},{"i":15,"start":104.36,"end":107.14,"text":"Nhà đổ đúc hoàn toàn từ dưới lên trên luôn.","n":10},{"i":16,"start":107.48,"end":109.98,"text":"Tủ bếp trên dưới gia chủ cũng để lại cho gia chủ.","n":12},{"i":17,"start":110,"end":118.72,"text":"có sân sau để chúng ta có thể phơi phóng, sinh hoạt thêm và toilet sử dụng chung cho toàn bộ khu vực tầng trệt ở đây ạ.","n":28},{"i":18,"start":119.2,"end":126.98,"text":"Và phải nói với tầm phân khúc dưới 4 tỷ mà chúng ta có một căn nhà thiết kế đầy đủ chỉn chu, một trệt lên đến tận 3 tầng lầu như thế này.","n":34},{"i":19,"start":127.2,"end":139.64,"text":"Và lên với không gian của phía khu vực lầu 1 thì chúng ta sẽ có 2 căn phòng ngủ mát tơ ở 2 đầu, cùng với đó phòng ngủ nào cũng đều được thiết kế có ban công thoáng, toilet khép kín bên trong,","n":45},{"i":20,"start":140.16,"end":144.36,"text":"diện tích rộng rãi để gia đình mình về có thể bố trí nội thất đầy đủ luôn.","n":18},{"i":21,"start":144.8,"end":157.36,"text":"Và lên với lầu 2 thì chúng ta vẫn đảm bảo thiết kế giống như lầu 1 cũng có 2 phòng ngủ mát tơ ở 2 đầu, toilet khép kín, ban công thoáng trước và sau, phù hợp cho gia đình mình đông thành viên","n":45},{"i":22,"start":157.36,"end":159.4,"text":"có từ 4 đến 8 thành viên.","n":7},{"i":23,"start":159.4,"end":164.88,"text":"Lên với không gian của phía khu vực lầu 3 thì chúng ta sẽ có sân thượng trước, sân thượng sau.","n":21},{"i":24,"start":165,"end":169.08,"text":"Không gian giặt phơi cùng với đó là phòng thờ riêng cho căn nhà ngày hôm nay.","n":17},{"i":25,"start":169.28,"end":174.24,"text":"Đứng từ khu vực sân thượng, chúng ta có thể bao quát được toàn cảnh xung quanh của khu đô thị.","n":21},{"i":26,"start":175.98,"end":183.94,"text":"Khu dân cư đông đúc, cây xanh mát mẻ không khí trong lành, một khu đô thị văn minh được quy hoạch chuẩn trị bài bản.","n":26},{"i":27,"start":184.16,"end":193.92,"text":"Một căn nhà thiết kế chắc chắn kiên cố và gia chủ đang đưa ra một cái mức cực kỳ là tốt cho quý cô chú và anh chị chúng ta đang tìm nhà trong khu đô thị năm sau đây ạ.","n":42},{"i":28,"start":193.92,"end":202.08,"text":"3 tỷ 990 triệu, còn thương lượng pháp lý chuẩn cho chúng ta, sổ hồng riêng nhà đã hoàn công đầy đủ hết rồi.","n":24},{"i":29,"start":202.4,"end":208.94,"text":"Rồi cô chú anh chị cảm thấy căn nhà này phù hợp với nhu cầu của mình thì phải tranh thủ nhanh thì mới còn với căn nhà ngày hôm nay.","n":31},{"i":30,"start":209.24,"end":218.6,"text":"Xin cảm ơn cô chú anh chị đã quan tâm và đừng quên nhấn nút đăng ký kênh để chúng ta cùng xem nhiều căn nhà đẹp giá tốt trên kênh Nhà Sinh Minh Thùy ạ.","n":36},{"i":31,"start":218.92,"end":219.4,"text":"Xin chào.","n":2}],"silences":[[0.2,0.75],[7.9,8.3],[11.7,12.05],[29.75,30.1],[35.5,35.9],[39,39.35],[42.5,42.85],[44.45,44.9],[50.25,50.7],[53.75,54.5],[55.3,55.8],[55.95,56.9],[57.8,58.35],[67.5,67.95],[68.3,69.7],[70.95,71.35],[71.5,72.65],[73.4,73.8],[74.65,75.75],[76.9,77.65],[77.8,79.5],[82,87.5],[94.8,95.15],[113.25,113.65],[118.7,119.2],[127.05,127.4],[137.9,138.4],[139.7,140.15],[151.6,152.1],[169.15,169.55],[174.3,174.7],[175.6,176.25],[177,177.5],[193.95,194.35],[196.2,196.6],[202.1,202.5],[212.4,212.9],[213,213.55],[219.5,224.9]],"fillCuts":[],"mumbleCuts":[[174.36,175.88],[177.28,177.98000000000002],[212.72,214.9]],"dur":224.87}