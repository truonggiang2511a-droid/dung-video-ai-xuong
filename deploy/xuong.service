# Máy dựng Dựng Video AI (HyperFrames) — dịch vụ systemd trên VPS
[Unit]
Description=May dung Dung Video AI (HyperFrames)
After=network-online.target
Wants=network-online.target

[Service]
User=xuong
WorkingDirectory=/opt/xuong
ExecStart=/usr/bin/node server.mjs
Restart=always
RestartSec=5
# khoá & cấu hình đọc từ /opt/xuong/cau-hinh.txt (server tự nạp)
Environment=NODE_ENV=production
# không cho chiếm hết RAM nếu 1 video quá nặng (VPS 24 GB)
MemoryMax=20G
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
