# Máy dựng Dựng Video AI (HyperFrames) — dịch vụ systemd trên VPS
[Unit]
Description=May dung Dung Video AI (HyperFrames)
After=network-online.target
Wants=network-online.target

[Service]
User=xuong
WorkingDirectory=/opt/xuong
ExecStart=/usr/bin/node server.mjs
Restart=always
RestartSec=5
# ưu tiên thấp: VPS có chương trình khác (MT5…) thì chương trình đó luôn được CPU / ổ đĩa trước
Nice=10
CPUWeight=20
IOWeight=20
# khoá & cấu hình đọc từ /opt/xuong/cau-hinh.txt (server tự nạp)
Environment=NODE_ENV=production
# không cho 1 video quá nặng chiếm hết RAM (để lại ~15 % cho hệ thống)
MemoryMax=85%
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
